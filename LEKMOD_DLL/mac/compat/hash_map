// MSVC's <hash_map>: stdext::hash_map. The game core only uses it for keyed lookups,
// never iteration in simulation code, so std::unordered_map semantics are equivalent.
#pragma once
#include <unordered_map>
#include <string>
namespace stdext {
using std::hash;
template <class K, class V, class H = std::hash<K>, class E = std::equal_to<K>,
          class A = std::allocator<std::pair<const K, V> > >
class hash_map : public std::unordered_map<K, V, H, E, A> {};
}
